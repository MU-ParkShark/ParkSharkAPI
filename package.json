{
  "name": "parkshark",
  "version": "0.0.1",
  "description": "This is a REST API backend for the ParkShark application.",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "copy-schema": "copyfiles -u 1 graphql/**/*.graphql dist/graphql",
    "build": "npx tsc && npm run copy-schema",
    "start": "node dist/index.js",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\""
  },
  "keywords": [
    "ParkShark",
    "parking",
    "mobile",
    "application"
  ],
  "author": "Davian Albarran <dalbarran.dev@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.9.0",
    "joi": "^17.12.0",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.0.1",
    "typescript": "^5.3.2"
  }
}
